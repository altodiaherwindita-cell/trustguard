# Copy to .env and fill in. `docker compose up` refuses to start until
# DB_PASSWORD and JWT_SECRET are set — there are no working defaults.

# Database Configuration
DB_USER=trustguard
# Generate: openssl rand -base64 24
DB_PASSWORD=
DB_NAME=trustguard
DB_HOST=db
DB_PORT=5432

# Seeds the default admin (admin@trustguard.ai) with this password, hashed by
# init.sql via pgcrypto. Leave blank to seed no admin at all. Either way,
# must_change_password forces a change on first login.
ADMIN_PASSWORD=

# Alternative: Use full connection string (overrides the DB_* values above)
# DATABASE_URL=postgresql://trustguard:password@db:5432/trustguard

# API Configuration
API_PORT=3000
NODE_ENV=production
# Generate: openssl rand -hex 32
JWT_SECRET=

# Email (SMTP) and AI (AI_*) configuration can also be set from Settings in the
# UI, which is admin-only and takes precedence over these values. Everything
# below is the fallback for anything not set there — a blank field in the UI
# restores the environment value. Leave them unset here if you would rather
# configure the app from the browser.
#
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false          # true for implicit TLS on port 465
# SMTP_FROM="TrustGuard Platform <noreply@trustguard.ai>"
# SMTP_REJECT_UNAUTHORIZED=true
#
# AI_PROVIDER=openai         # openai | anthropic | google
# AI_API_KEY=
# AI_MODEL=gpt-4o-mini       # anthropic has no default; it must be set
# AI_BASE_URL=               # point at any OpenAI-compatible router

# Web Configuration
WEB_PORT=80
# Origin emailed invitation links point at. Must be a URL the *recipient's
# browser* can reach, so set this to the public hostname in any real
# deployment. Defaults to the web service's published port above.
FRONTEND_URL=http://localhost
# Leave blank to call the app's own origin (nginx proxies /api/ to the api
# container). Only set this to point the browser at a separate API host — it is
# baked into the client bundle, so it must be a URL the *browser* can reach.
VITE_API_URL=
